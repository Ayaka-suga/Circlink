<%= stylesheet_link_tag 'show', :media => "all" %>

<div class="show-container">
  <!-- 戻るナビゲーション -->
  <div class="top-nav">
    <%= link_to tweets_path, class: "btn-back" do %>
      ← 出欠を回答する
    <% end %>
  </div>

  <% my_like = @tweet.likes.find_by(user_id: current_user.id) if user_signed_in? %>
  <% is_past_deadline = @tweet.deadline.present? && Time.current > @tweet.deadline %>

  <!-- イベント概要カード -->
  <div class="event-summary-card">
    <div class="card-header-row">
      <span class="tag-category"><%= @tweet.category %></span>
      <div class="status-deadline-group">
        <% if my_like %>
          <span class="tag-status answered"><%= my_like.status %></span>
        <% else %>
          <span class="tag-status unanswered">未回答</span>
        <% end %>
      </div>
    </div>

    <h1 class="event-title"><%= @tweet.event %></h1>

    <div class="meta-row">
      <div class="meta-item">
        📅 <%= @tweet.start_time&.strftime("%Y年 %m月%d日 %H:%M") %> 〜 <%= @tweet.end_time&.strftime("%H:%M") %>
      </div>
      <div class="meta-item">
        📍 <%= @tweet.place.presence || "場所未定" %>
      </div>
    </div>

    <div class="deadline-row">
      回答期限：<%= @tweet.deadline ? @tweet.deadline.strftime("%m/%d(%a) %H:%M") : "なし" %>
    </div>
  </div>

  <!-- 出欠選択・送信フォーム -->
  <% if user_signed_in? %>
    <% if is_past_deadline %>
      <div class="closed-banner">
        ⚠️ このイベントの回答受付は終了しました。
      </div>
    <% else %>
      <%= form_with url: tweet_likes_path(tweet_id: @tweet.id), method: :post, local: true, class: "attendance-form" do |f| %>
        <div class="form-card">
          <div class="form-title-row">
            <h2 class="section-title">出欠を選択</h2>
            <span class="badge-required">必須</span>
          </div>

      <div class="option-grid">
        <!-- 参加 -->
        <label class="option-card option-join">
          <%= f.radio_button :status, "参加", checked: (my_like&.status == "参加" || my_like.nil?), class: "radio-input" %>
          <div class="card-content">
            <%= image_tag "icon_join.png", class: "status-icon", alt: "参加" %>
            <span class="option-label">参加します</span>
          </div>
        </label>

        <!-- 未定 -->
        <label class="option-card option-maybe">
          <%= f.radio_button :status, "未定", checked: (my_like&.status == "未定"), class: "radio-input" %>
          <div class="card-content">
            <%= image_tag "icon_maybe.png", class: "status-icon", alt: "未定" %>
            <span class="option-label">未定です</span>
          </div>
        </label>

        <!-- 不参加 -->
        <label class="option-card option-decline">
          <%= f.radio_button :status, "不参加", checked: (my_like&.status == "不参加"), class: "radio-input" %>
          <div class="card-content">
            <%= image_tag "icon_decline.png", class: "status-icon", alt: "不参加" %>
            <span class="option-label">参加できません</span>
          </div>
        </label>
      </div>

          <!-- コメント機能（必要に応じてモデルへ保存） -->
          <div class="comment-group">
            <%= f.label :comment, "コメント（任意）", class: "comment-label" %>
            <%= f.text_area :comment, placeholder: "遅刻の連絡や共有事項があれば入力してください", class: "comment-textarea" %>
          </div>
        </div>

        <!-- 画面下部アクションボタン -->
        <div class="form-actions">
          <%= link_to "キャンセル", tweets_path, class: "btn-cancel" %>
          <%= f.submit "回答する", class: "btn-submit" %>
        </div>
      <% end %>
    <% end %>
  <% end %>

  <!-- イベント詳細＆参加者一覧エリア -->
  <div class="details-section">
    <h3 class="sub-title">イベント詳細</h3>
    <div class="details-body">
      <%= simple_format(@tweet.about) %>
    </div>
  </div>

  <div class="members-section">
    <h3 class="sub-title">現在の回答状況</h3>
    <div class="member-lists">
      <div class="member-group">
        <h4>参加 (<%= @tweet.likes.where(status: "参加").count %>人)</h4>
        <ul>
          <% @tweet.likes.where(status: "参加").each do |like| %>
            <li><%= like.user.username rescue "ユーザー" %></li>
          <% end %>
        </ul>
      </div>

      <div class="member-group">
        <h4>未定 (<%= @tweet.likes.where(status: "未定").count %>人)</h4>
        <ul>
          <% @tweet.likes.where(status: "未定").each do |like| %>
            <li><%= like.user.username rescue "ユーザー" %></li>
          <% end %>
        </ul>
      </div>

      <div class="member-group">
        <h4>不参加 (<%= @tweet.likes.where(status: "不参加").count %>人)</h4>
        <ul>
          <% @tweet.likes.where(status: "不参加").each do |like| %>
            <li><%= like.user.username rescue "ユーザー" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <!-- 投稿者メニュー -->
  <% if user_signed_in? && current_user.id == @tweet.user_id %>
    <div class="owner-actions">
      <%= link_to "イベントを編集", edit_tweet_path(@tweet.id), class: "btn-edit" %>
      <%= link_to "削除", tweet_path(@tweet.id), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn-delete" %>
    </div>
  <% end %>
</div>